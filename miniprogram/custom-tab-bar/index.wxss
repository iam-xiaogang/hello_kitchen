.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 32rpx rgba(92, 74, 61, 0.08);
  padding: 12rpx 16rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}
.icon-bubble {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease, background 0.25s ease;
}
.icon {
  font-size: 44rpx;
  line-height: 1;
}
.label {
  font-size: 22rpx;
  color: #9a8b7e;
  margin-top: 6rpx;
  transition: color 0.25s ease;
}
.tab-item.active .icon-bubble {
  background: #fff0e6;
  transform: translateY(-6rpx) scale(1.08);
}
.tab-item.active .label {
  color: #ff7a5c;
  font-weight: 600;
}
