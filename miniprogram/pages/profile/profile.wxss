.user {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 40rpx;
  background: #fff0e6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  margin-right: 24rpx;
}
.u-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #5c4a3d;
}
.u-sub {
  font-size: 24rpx;
  color: #c9bbad;
  margin-top: 8rpx;
}

.prefs {
  padding: 28rpx 32rpx;
}
.pref-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}
.pref-label {
  font-size: 30rpx;
  color: #5c4a3d;
}
.spice-row {
  display: flex;
  gap: 12rpx;
}
.spice {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #fff3e6;
  color: #9a8b7e;
  font-size: 24rpx;
  transition: all 0.2s ease;
}
.spice.on {
  background: #ff7a5c;
  color: #fff;
  font-weight: 700;
}
.pref-tip {
  font-size: 22rpx;
  color: #c9bbad;
  padding-top: 12rpx;
  border-top: 2rpx solid #f7efe6;
}

.history {
  margin-top: 4rpx;
}
.h-item {
  margin-bottom: 16rpx;
}

.about {
  padding: 8rpx 32rpx;
}
.about-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #5c4a3d;
  border-bottom: 2rpx solid #f7efe6;
}
.about-row:last-child {
  border-bottom: none;
}
.about-row .val {
  color: #9a8b7e;
  font-size: 26rpx;
}
