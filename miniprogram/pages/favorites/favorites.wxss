.count-bar {
  font-size: 26rpx;
  color: #9a8b7e;
  padding: 8rpx 8rpx 0;
}
.count-bar .num {
  color: #ff7a5c;
  font-weight: 700;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: 48.5%;
  margin-bottom: 24rpx;
}
.empty .sub {
  font-size: 24rpx;
  color: #c9bbad;
  margin-top: 8rpx;
}
