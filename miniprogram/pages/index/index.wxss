.header {
  padding: 24rpx 8rpx 0;
}
.hi {
  font-size: 40rpx;
  font-weight: 800;
  color: #5c4a3d;
}
.sub {
  font-size: 24rpx;
  color: #c9bbad;
  margin-top: 6rpx;
}
.search-bar {
  margin-top: 24rpx;
}

/* 今天吃什么 */
.today {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #ffb3a7 0%, #ff8e7b 100%);
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 16rpx 40rpx rgba(255, 122, 92, 0.35);
}
.today-hover {
  transform: scale(0.98);
}
.today-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.today-emoji {
  font-size: 84rpx;
  margin-right: 24rpx;
}
.today-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.today-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}
.today-btn {
  background: #fff;
  color: #ff7a5c;
  font-size: 28rpx;
  font-weight: 700;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 猜你喜欢网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: 48.5%;
  margin-bottom: 24rpx;
}

/* 结果弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(60, 45, 35, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.result-pop {
  width: 580rpx;
  background: #fff9f0;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: rise 0.3s ease;
}
@keyframes rise {
  from { transform: translateY(40rpx) scale(0.9); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}
.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #5c4a3d;
}
.result-recipe {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 0 32rpx;
}
.result-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 24rpx;
  overflow: hidden;
}
.result-ph {
  background: #f0eae2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  line-height: 1;
}
.result-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #5c4a3d;
  margin-top: 16rpx;
}
.result-meta {
  font-size: 24rpx;
  color: #9a8b7e;
  margin-top: 8rpx;
}
.result-actions {
  display: flex;
  gap: 20rpx;
}
