<view class="page">
  <view class="intro card" wx:if="{{recipes.length}}">
    <view class="intro-title">今晚想吃什么？💕</view>
    <input class="title-input" maxlength="30" value="{{title}}" bindinput="onTitleInput" placeholder="给菜单起个名字" />
    <view class="intro-tip">选好后生成菜单，再通过微信发给另一半</view>
  </view>

  <view class="menu-list" wx:if="{{recipes.length}}">
    <view class="menu-item" wx:for="{{recipes}}" wx:key="id">
      <recipe-card recipe="{{item}}" type="row" showFavorite="{{false}}" />
      <view class="remove" catchtap="onRemove" data-id="{{item.id}}">移除</view>
    </view>
  </view>

  <view class="actions" wx:if="{{recipes.length}}">
    <button class="btn btn-ghost" bindtap="onAddMore">继续选菜</button>
    <button wx:if="{{!shareToken}}" class="btn btn-primary" loading="{{creating}}" bindtap="onCreateShare">生成分享菜单</button>
    <button wx:else class="btn btn-primary" open-type="share">发给另一半 💌</button>
    <view class="ready" wx:if="{{shareToken}}">菜单已经生成，有效期 30 天</view>
  </view>

  <view class="empty" wx:else>
    <mascot emoji="🍽️" text="点菜篮还是空的" size="140" />
    <button class="btn btn-primary" bindtap="onAddMore">去选喜欢的菜</button>
  </view>
</view>
