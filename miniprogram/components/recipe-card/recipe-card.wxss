.rc {
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 122, 92, 0.08);
  overflow: hidden;
  transition: transform 0.15s ease;
}
.rc-hover {
  transform: scale(0.97);
}

/* ---- 网格卡片 ---- */
.rc-grid .cover {
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.rc-grid .cat {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #5c4a3d;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}
.rc-grid .body {
  padding: 18rpx 20rpx 22rpx;
}
.rc-grid .name {
  font-size: 28rpx;
  font-weight: 600;
  color: #5c4a3d;
  line-height: 1.35;
  min-height: 76rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---- 横排卡片 ---- */
.rc-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.rc-row .cover {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.rc-row .cat {
  display: none;
}
.rc-row .body {
  flex: 1;
  padding: 16rpx 20rpx;
  overflow: hidden;
}
.rc-row .name {
  font-size: 30rpx;
  font-weight: 600;
  color: #5c4a3d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---- 封面图 / 无图占位 ---- */
.cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 0.28s ease;
}
.cover-img.loaded { opacity: 1; }
.cover-ph {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  box-sizing: border-box;
}
.ph-emoji {
  font-size: 80rpx;
  line-height: 1;
}
.image-loading {
  position: absolute;
  left: 50%;
  bottom: 18rpx;
  width: 44rpx;
  height: 6rpx;
  margin-left: -22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
}
.image-loading::after {
  content: '';
  display: block;
  width: 50%;
  height: 100%;
  border-radius: inherit;
  background: #ff9a8b;
  animation: image-loading 1s ease-in-out infinite;
}
@keyframes image-loading {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(200%); }
}
.rc-row .ph-emoji {
  font-size: 56rpx;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}
.time {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #c9bbad;
}

.fav {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
}
.heart {
  font-size: 30rpx;
  line-height: 1;
}
.heart.on {
  animation: pop 0.35s ease;
}
@keyframes pop {
  0% { transform: scale(1); }
  50% { transform: scale(1.5); }
  100% { transform: scale(1); }
}
