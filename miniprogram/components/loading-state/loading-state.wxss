.loading-state {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9a8b7e;
}
.loading-state.fullscreen { min-height: 70vh; }
.cooking { position: relative; width: 150rpx; height: 150rpx; }
.pot { position: absolute; left: 15rpx; bottom: 0; width: 120rpx; animation: pot-bounce 1.1s ease-in-out infinite; }
.pot-body { font-size: 92rpx; line-height: 1; text-align: center; }
.pot-lid { position: absolute; left: 35rpx; top: 8rpx; width: 50rpx; height: 8rpx; border-radius: 999rpx; background: #ff7a5c; animation: lid-jump 1.1s ease-in-out infinite; }
.steam { position: absolute; top: 0; width: 18rpx; height: 54rpx; border-radius: 50%; border-left: 5rpx solid rgba(255, 122, 92, 0.42); animation: steam-up 1.5s ease-out infinite; }
.steam-a { left: 51rpx; }
.steam-b { left: 88rpx; animation-delay: .45s; }
.loading-text { margin-top: 24rpx; font-size: 27rpx; }
.loading-dots { display: flex; margin-top: 12rpx; }
.loading-dots text { width: 10rpx; height: 10rpx; margin: 0 6rpx; border-radius: 50%; background: #ffb3a7; animation: dot-pulse 1.2s ease-in-out infinite; }
.loading-dots text:nth-child(2) { animation-delay: .18s; }
.loading-dots text:nth-child(3) { animation-delay: .36s; }
@keyframes pot-bounce { 0%, 100% { transform: translateY(0) rotate(-2deg); } 50% { transform: translateY(-8rpx) rotate(2deg); } }
@keyframes lid-jump { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-12rpx) rotate(5deg); } }
@keyframes steam-up { 0% { opacity: 0; transform: translateY(24rpx) scale(.7); } 35% { opacity: 1; } 100% { opacity: 0; transform: translateY(-20rpx) scale(1.15); } }
@keyframes dot-pulse { 0%, 70%, 100% { transform: scale(.65); opacity: .45; } 35% { transform: scale(1); opacity: 1; } }
