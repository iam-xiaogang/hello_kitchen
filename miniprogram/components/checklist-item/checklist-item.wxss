.ci {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 16rpx;
  transition: background 0.2s ease;
}
.ci-hover {
  background: #fff7f3;
}
.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 3rpx solid #e6d8ca;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.check.checked {
  background: #a8d8b9;
  border-color: #a8d8b9;
  animation: boing 0.3s ease;
}
.tick {
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
}
@keyframes boing {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}
.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
  overflow: hidden;
}
.label {
  font-size: 30rpx;
  color: #5c4a3d;
  transition: color 0.2s ease;
  position: relative;
}
.sub {
  font-size: 24rpx;
  color: #c9bbad;
  margin-top: 4rpx;
}
.ci.done .label {
  color: #c9bbad;
  text-decoration: line-through;
}
.ci.done .sub {
  color: #dcd2c6;
}
